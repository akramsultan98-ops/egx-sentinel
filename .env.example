APP_ENV=development
POSTGRES_DB=egx_sentinel
POSTGRES_USER=egx
POSTGRES_PASSWORD=CHANGE_ME
# Connection string used by the engine and the migration runner.
DATABASE_URL=postgresql://egx:CHANGE_ME@127.0.0.1:5433/egx_sentinel
# Provider selection. `unconfigured` refuses to serve data (the safe default).
# `manual` reads operator-maintained files from MARKET_DATA_DIR. No licensed
# feed has been authorised yet — see docs/data-source-policy.md.
MARKET_DATA_PROVIDER=unconfigured
MARKET_DATA_DIR=
MARKET_DATA_API_KEY=
# Portfolio the CLI decides against. Never defaulted: an unset value is an error.
EGX_PORTFOLIO_ID=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
