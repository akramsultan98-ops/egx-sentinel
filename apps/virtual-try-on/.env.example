# ---------------------------------------------------------------------------
# Virtual try-on module
#
# Copy to .env.local and fill in. Everything here is read on the server only —
# no provider credential is ever sent to the browser.
# ---------------------------------------------------------------------------

# Which backend renders try-ons: gemini | replicate | simulation
#
# Leaving this unset selects `simulation`, which composites the product artwork
# over the photo locally. It generates nothing, and every result it produces is
# labelled as a preview in the UI and watermarked in the image itself.
TRYON_PROVIDER=simulation

# --- gemini -----------------------------------------------------------------
# Google AI Studio key with access to an image-capable Gemini model.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=

# --- replicate --------------------------------------------------------------
# API token from replicate.com/account.
REPLICATE_API_TOKEN=
# A try-on model, as `owner/name` or `owner/name:version`.
REPLICATE_TRYON_MODEL=
# Only needed when the model's input fields differ from the defaults below.
# REPLICATE_TRYON_INPUT_MAP={"person":"human_img","garment":"garm_img","description":"garment_des"}

# --- storefront presentation (public) ---------------------------------------
# These are inlined into the client bundle; keep them non-sensitive.
NEXT_PUBLIC_STORE_NAME=STORE
NEXT_PUBLIC_STORE_CURRENCY=USD
NEXT_PUBLIC_STORE_LOCALE=en-US
